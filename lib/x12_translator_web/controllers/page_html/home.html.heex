<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">
        X12Translator
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Convert complex X12 EDI healthcare transactions into developer-friendly JSON format
      </p>
    </div>

    <!-- Main CTA -->
    <div class="text-center mb-16">
      <a
        href="/converter"
        class="inline-block px-8 py-4 bg-blue-600 text-white text-lg font-semibold rounded-lg shadow-lg hover:bg-blue-700 transition transform hover:scale-105"
      >
        Start Converting X12 Files →
      </a>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
          <svg
            class="w-6 h-6 text-blue-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Comprehensive Validation</h3>
        <p class="text-gray-600">
          Validates X12 structure, syntax, and business rules before conversion
        </p>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
          <svg
            class="w-6 h-6 text-green-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
            />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Semantic JSON Output</h3>
        <p class="text-gray-600">
          Hierarchical structure with claims, service lines, and all relevant data
        </p>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
          <svg
            class="w-6 h-6 text-purple-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"
            />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Fast & Reliable</h3>
        <p class="text-gray-600">
          Built with Elixir for speed, concurrency, and fault tolerance
        </p>
      </div>
    </div>

    <!-- Supported Transaction Types -->
    <div class="bg-white rounded-lg shadow-md p-8 mb-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
        Supported Transaction Types
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">837P - Professional Claims</h3>
          <p class="text-gray-600 mb-4">
            Healthcare claims from physicians, suppliers, and other non-institutional providers
          </p>
          <ul class="text-sm text-gray-500 space-y-1">
            <li>• Provider information</li>
            <li>• Patient demographics</li>
            <li>• Diagnosis codes (ICD-10)</li>
            <li>• Service lines with CPT codes</li>
          </ul>
        </div>
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            837I - Institutional Claims
          </h3>
          <p class="text-gray-600 mb-4">
            Healthcare claims from hospitals, skilled nursing facilities, and other institutions
          </p>
          <ul class="text-sm text-gray-500 space-y-1">
            <li>• Facility information</li>
            <li>• Admission/discharge dates</li>
            <li>• Revenue codes</li>
            <li>• Service lines with HCPCS codes</li>
          </ul>
        </div>
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            837D - Dental Claims
          </h3>
          <p class="text-gray-600 mb-4">
            Healthcare claims from dentists and dental providers for oral healthcare services
          </p>
          <ul class="text-sm text-gray-500 space-y-1">
            <li>• Dental provider information</li>
            <li>• Patient demographics</li>
            <li>• Tooth numbers and surfaces</li>
            <li>• Service lines with CDT codes</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="bg-white rounded-lg shadow-md p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">How It Works</h2>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">
            1
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Upload or Paste</h3>
          <p class="text-sm text-gray-600">
            Upload your X12 file or paste the content directly
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">
            2
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Validate</h3>
          <p class="text-sm text-gray-600">
            Check for structural and business rule violations
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">
            3
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Convert</h3>
          <p class="text-sm text-gray-600">Transform X12 into clean, semantic JSON</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">
            4
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Use Your Data</h3>
          <p class="text-sm text-gray-600">Download or copy the JSON for your application</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-16 text-center text-gray-500 text-sm">
      <p>Built with Phoenix Framework and Elixir</p>
      <p class="mt-2">
        <a href="/converter" class="text-blue-600 hover:text-blue-700">
          Try the Converter
        </a>
        |
        <a
          href="https://github.com/yourusername/x12_translator"
          class="text-blue-600 hover:text-blue-700 ml-2"
        >
          View on GitHub
        </a>
      </p>
    </div>
  </div>
</div>
